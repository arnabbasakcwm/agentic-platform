# Copy this file to .env and fill in real values. .env is gitignored.

# Primary provider used for MVP smoke tests.
MOONSHOT_API_KEY=
# Wired but not required until you use these providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Project persistence. Leave MONGODB_URI empty to keep projects in memory (lost on
# restart). Local server: mongodb://localhost:27017 — or an Atlas mongodb+srv:// URI.
MONGODB_URI=
MONGODB_DB=agentic_platform

# Signs sign-in tokens. Use a long random value, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, a random secret is generated at startup and every restart signs
# everyone out.
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# Tool keys (opt-in, side-effecting tools only). Not required unless a project
# explicitly enables the matching tool in its available_tools.
TAVILY_API_KEY=            # required by the "web_search" tool
WOLFRAM_ALPHA_APPID=       # required by the "wolfram_alpha" tool
PUBMED_API_KEY=            # optional; raises NCBI's rate limit for the "pubmed" tool

# Encrypts secrets the platform stores for users (MCP server URLs and headers). Required
# to connect MCP servers; keep it stable, or stored servers must be connected again.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRET_KEY=
# Local development only: allow http:// MCP servers on this machine.
MCP_ALLOW_INSECURE_LOCAL=

# Seconds one model request may take before it fails into the agent's retry loop (default 180).
LLM_REQUEST_TIMEOUT_S=

# Email (the Run tab's "Send by email"). Any SMTP provider: SES, SendGrid, Mailgun,
# Gmail, a company relay. Leave SMTP_HOST empty to turn email off (the API answers 503).
SMTP_HOST=
SMTP_PORT=587               # 587 with STARTTLS (default), 465 with SMTP_SECURITY=ssl
SMTP_SECURITY=starttls      # starttls | ssl | none
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                  # e.g. "Agentic Platform <noreply@example.com>"
EMAIL_RATE_LIMIT_PER_HOUR=10  # emails per user per hour

# PDF exports use a Unicode TrueType font: DejaVu in the Docker image, Arial on Windows.
# Point at another .ttf to override (optional).
PDF_FONT_PATH=

# Agents that use web_search or knowledge_search must cite their sources ([n] markers
# and a Sources section, checked by the platform). true (default) | false.
REQUIRE_CITATIONS=true
