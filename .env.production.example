# Production settings for docker-compose.prod.yml. Copy to .env.production on the server
# (cp .env.production.example .env.production && chmod 600 .env.production) and fill in.
# .env.production is gitignored. Never commit it, and never bake it into an image.

# ------------------------------------------------------------------ site
# The public hostname. Point its DNS A/AAAA record at this server and open ports 80 and
# 443; Caddy then gets a Let's Encrypt certificate on its own. Use ":80" for plain HTTP
# behind a load balancer that terminates TLS.
DOMAIN=agents.example.com
# Optional image tag; ./deploy.sh sets it to the git commit when left empty.
IMAGE_TAG=

# ------------------------------------------------------------------ database (container)
# The API's MONGODB_URI is built from these by docker-compose.prod.yml. Use URL-safe
# values (letters, digits, - and _), e.g.:  openssl rand -hex 24
# These take effect when the database volume is first created; changing them later
# needs the user changed inside MongoDB too.
MONGO_ROOT_USER=platform
MONGO_ROOT_PASSWORD=
MONGODB_DB=agentic_platform

# ------------------------------------------------------------------ required secrets
# Signs sign-in tokens. Keep stable, or every restart signs everyone out.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
# Encrypts stored MCP server URLs and headers. Keep stable, or stored servers must be
# connected again.
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PLATFORM_SECRET_KEY=

# ------------------------------------------------------------------ model providers
# Only the providers your projects use need keys.
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_REQUEST_TIMEOUT_S=

# ------------------------------------------------------------------ AWS (Bedrock, AgentCore deploys, BigQuery federation)
# On EC2, prefer an instance role and leave the keys empty (set the instance metadata
# hop limit to 2 so containers can reach it). Otherwise an IAM user's keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
AGENTCORE_REGION=ap-south-1
AGENTCORE_EXECUTION_ROLE_ARN=
AGENTCORE_CODE_BUCKET=

# ------------------------------------------------------------------ BigQuery (optional)
GCP_WIF_AUDIENCE=
GCP_SERVICE_ACCOUNT=
BIGQUERY_PROJECT=

# ------------------------------------------------------------------ tools (opt-in)
TAVILY_API_KEY=
WOLFRAM_ALPHA_APPID=
PUBMED_API_KEY=

# Email (the Run tab's "Send by email"). Any SMTP provider: SES, SendGrid, Mailgun,
# Gmail, a company relay. Leave SMTP_HOST empty to turn email off (the API answers 503).
SMTP_HOST=
SMTP_PORT=587               # 587 with STARTTLS (default), 465 with SMTP_SECURITY=ssl
SMTP_SECURITY=starttls      # starttls | ssl | none
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                  # e.g. "Agentic Platform <noreply@example.com>"
EMAIL_RATE_LIMIT_PER_HOUR=10  # emails per user per hour

# PDF exports use a Unicode TrueType font: DejaVu in the Docker image, Arial on Windows.
# Point at another .ttf to override (optional).
PDF_FONT_PATH=

# Agents that use web_search or knowledge_search must cite their sources ([n] markers
# and a Sources section, checked by the platform). true (default) | false.
REQUIRE_CITATIONS=true
